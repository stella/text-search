{
  "name": "@stll/text-search",
  "version": "1.1.0",
  "description": "Multi-engine text search orchestrator for Node.js and Bun. Routes literals, regex, and fuzzy patterns to the right engine automatically.",
  "keywords": [
    "aho-corasick",
    "fuzzy",
    "multi-pattern",
    "orchestrator",
    "regex",
    "text-search"
  ],
  "homepage": "https://github.com/stella/text-search#readme",
  "bugs": {
    "url": "https://github.com/stella/text-search/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/stella/text-search"
  },
  "files": [
    "NOTICE",
    "dist"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check:toolchain": "stll-toolchain-check",
    "build": "tsdown",
    "build:js": "tsdown",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "perf:contracts": "bun scripts/contract-fixture-perf.mjs",
    "test:runtime:bun": "bun scripts/runtime-smoke.mjs",
    "test:runtime:node": "node scripts/runtime-smoke.mjs",
    "rust:hawk": "cargo +1.97.1 hawk check --manifest-path Cargo.toml --target-dir target/hawk -D warnings -A hawk::dead_public -A hawk::unnecessary_public -D hawk::unnecessary_restricted_visibility -D hawk::unnecessary_crate_visibility",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.json",
    "lint": "bun --bun oxlint -c oxlint.config.ts --report-unused-disable-directives-severity=error --deny-warnings --type-aware .",
    "lint:fix": "bun --bun oxlint -c oxlint.config.ts --type-aware --fix .",
    "version:check": "node scripts/version-sync.mjs check",
    "version:sync": "node scripts/version-sync.mjs sync",
    "changeset": "changeset",
    "changeset:version": "changeset version && node scripts/sync-changeset-version.mjs",
    "sync-ai": "bash scripts/sync-ai-skills.sh",
    "sync-ai:check": "bash scripts/sync-ai-skills.sh --check",
    "cloud:setup": "stll-cloud-setup"
  },
  "dependencies": {
    "@stll/aho-corasick": "^1.0.4",
    "@stll/fuzzy-search": "^1.4.0",
    "@stll/regex-set": "^1.0.9"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@stll/aho-corasick-wasm": "^1.0.4",
    "@stll/fuzzy-search-wasm": "^1.4.0",
    "@stll/oxlint-config": "3.2.1",
    "@stll/oxlint-plugin": "0.7.0",
    "@stll/regex-set-wasm": "^1.0.9",
    "@stll/typescript-config": "0.10.0",
    "@types/node": "26.6.5",
    "bun-types": "1.4.4",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsdown": "0.23.1",
    "unrun": "^0.3.1",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">= 18"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": []
}
