{
  "name": "@stll/text-search",
  "version": "0.1.2",
  "description": "Multi-engine text search orchestrator. Routes patterns to optimal engines: Aho-Corasick, RegexSet, or FuzzySearch.",
  "keywords": [
    "aho-corasick",
    "fuzzy",
    "multi-pattern",
    "orchestrator",
    "regex",
    "text-search"
  ],
  "homepage": "https://github.com/stella/text-search#readme",
  "bugs": {
    "url": "https://github.com/stella/text-search/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stella/text-search"
  },
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "lint": "oxlint .",
    "format": "oxfmt ."
  },
  "dependencies": {
    "@stll/aho-corasick": "^0.1.4",
    "@stll/fuzzy-search": "^0.1.1",
    "@stll/regex-set": "^0.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun-types": "^1.3.10",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "tsdown": "^0.21.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">= 18"
  }
}
