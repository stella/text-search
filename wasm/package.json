{
  "name": "@stll/text-search-wasm",
  "version": "1.0.9",
  "description": "Browser/WebAssembly build of @stll/text-search with the same API and Vite integration helpers.",
  "keywords": [
    "aho-corasick",
    "fuzzy",
    "multi-pattern",
    "orchestrator",
    "regex",
    "text-search",
    "wasm"
  ],
  "homepage": "https://github.com/stella/text-search#readme",
  "bugs": {
    "url": "https://github.com/stella/text-search/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stella/text-search"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "dist/wasm.mjs",
  "types": "dist/wasm.d.mts",
  "exports": {
    ".": {
      "types": "./dist/wasm.d.mts",
      "import": "./dist/wasm.mjs",
      "default": "./dist/wasm.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@stll/aho-corasick-wasm": "^1.0.4",
    "@stll/fuzzy-search-wasm": "^1.1.2",
    "@stll/regex-set-wasm": "^1.0.5"
  },
  "peerDependencies": {
    "vite": ">=5 <10"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
